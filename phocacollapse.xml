<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade" version="6.0">
	<name>plg_system_phocacollapse</name>
	<author>Jan Pavelka (www.phoca.cz) / Niklas Olofsson</author>
	<contributor>Niklas Olofsson</contributor>
	<creationDate>2026-08-04</creationDate>
	<authorEmail></authorEmail>
	<authorUrl>https://www.phoca.cz</authorUrl>
	<copyright>Jan Pavelka</copyright>
	<license>GNU/GPL</license>
	<version>6.1.5</version>
	<description>PLG_SYSTEM_PHOCACOLLAPSE_DESCRIPTION</description>
	<projectName>PhocaCollapse</projectName>

	<media destination="plg_system_phocacollapse" folder="media">
		<folder>css</folder>
		<folder>js</folder>
		<filename>index.html</filename>
	</media>

	<files>
		<folder>models</folder>
		<filename plugin="phocacollapse">phocacollapse.php</filename>
		<filename plugin="phocacollapse">index.html</filename>
		<filename plugin="phocacollapse">manifest.xml</filename>
	</files>

	<languages>
		<language tag="en-GB">language/en-GB/en-GB.plg_system_phocacollapse.ini</language>
		<language tag="en-GB">language/en-GB/en-GB.plg_system_phocacollapse.sys.ini</language>
		
		<language tag="de-DE">language/de-DE/de-DE.plg_system_phocacollapse.ini</language>
		<language tag="de-DE">language/de-DE/de-DE.plg_system_phocacollapse.sys.ini</language>
	
	</languages>

	<administration>
		<languages>
			<language tag="en-GB">language/en-GB/en-GB.plg_system_phocacollapse.ini</language>
			<language tag="en-GB">language/en-GB/en-GB.plg_system_phocacollapse.sys.ini</language>
			
			<language tag="de-DE">language/de-DE/de-DE.plg_system_phocacollapse.ini</language>
			<language tag="de-DE">language/de-DE/de-DE.plg_system_phocacollapse.sys.ini</language>
	
		</languages>
	</administration>

	<config>
		<fields name="params" addfieldpath="/plugins/system/phocacollapse/models/fields">
			<fieldset name="basic">

				<field 
					name="plugin_info_block" 
					type="note"
					class="w-100 border-bottom mb-5" 
					label=" "
					description="PLG_SYSTEM_PHOCACOLLAPSE_CUSTOM_DESC" >
				</field>

				<field
					name="button_style"
					type="list"
					default="icon_text"
					label="PLG_SYSTEM_PHOCACOLLAPSE_BUTTON_STYLE_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_BUTTON_STYLE_DESC">

					<option value="icon_text">PLG_SYSTEM_PHOCACOLLAPSE_ICON_TEXT</option>
					<option value="text_only">PLG_SYSTEM_PHOCACOLLAPSE_TEXT_ONLY</option>
					<option value="icon_only">PLG_SYSTEM_PHOCACOLLAPSE_ICON_ONLY</option>
				</field>


				<field
					name="icon_style"
					type="list"
					default="chevron"
					label="PLG_SYSTEM_PHOCACOLLAPSE_ICON_STYLE_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_ICON_STYLE_DESC"
					showon="button_style:icon_text,icon_only">

					<option value="eye">PLG_SYSTEM_PHOCACOLLAPSE_ICON_EYE</option>
					<option value="chevron">PLG_SYSTEM_PHOCACOLLAPSE_ICON_CHEVRON</option>
				</field>



				<field
					name="divider_1"
					type="note"
					class="w-100 my-1"
					label=" "
					description="" />
					
					
				
				<field
					name="title_field_index"
					type="list"
					default="1"
					label="PLG_SYSTEM_PHOCACOLLAPSE_TITLE_INDEX_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_TITLE_INDEX_DESC">
    
					<option value="1">1</option>
					<option value="2">2</option>
					<option value="3">3</option>
					<option value="4">4</option>
					<option value="5">5</option>
					<option value="6">6</option>
					<option value="7">7</option>
					<option value="8">8</option>
    				<option value="9">9</option>
    				<option value="10">10</option>
				</field>

	
				<field
					name="divider_2"
					type="note"
					class="w-100 my-3"
					label=" "
					description="" />


				<field
					name="initial_collapse_state"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="0"
					label="PLG_SYSTEM_PHOCACOLLAPSE_INITIAL_STATE_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_INITIAL_STATE_DESC">
					
					<option value="0">PLG_SYSTEM_PHOCACOLLAPSE_INITIAL_STATE_NO</option>
					<option value="1">PLG_SYSTEM_PHOCACOLLAPSE_INITIAL_STATE_YES</option>
				</field>

				<field
					name="initial_nested_collapse"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					showon="initial_collapse_state:0"
					label="PLG_SYSTEM_PHOCACOLLAPSE_NESTED_INITIAL_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_NESTED_INITIAL_DESC">
	
					<option value="0">PLG_SYSTEM_PHOCACOLLAPSE_INITIAL_STATE_NO</option>
					<option value="1">PLG_SYSTEM_PHOCACOLLAPSE_INITIAL_STATE_YES</option>
				</field>


				
				
				<field
					name="divider_3"
					type="note"
					class="w-100 my-1"
					label=" "
					description="" />
					
					
									
				<field
					name="individual_collapse"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					label="PLG_SYSTEM_PHOCACOLLAPSE_INDIVIDUAL_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_INDIVIDUAL_DESC">

					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				
				<field
					name="preserve_collapse_state"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					label="PLG_SYSTEM_PHOCACOLLAPSE_PRESERVE_STATE_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_PRESERVE_STATE_DESC">
					
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>


				<field
					name="restore_collapse_state_after_save"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					showon="preserve_collapse_state:1"
					label="PLG_SYSTEM_PHOCACOLLAPSE_RESTORE_STATE_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_RESTORE_STATE_DESC">
					
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>


				<field
					name="storage_type"
					type="list"
					default="session"
					showon="preserve_collapse_state:1[AND]restore_collapse_state_after_save:1"
					label="PLG_SYSTEM_PHOCACOLLAPSE_RESTORE_STORAGE_TYPE_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_RESTORE_STORAGE_TYPE_DESC">

					<option value="session">PLG_SYSTEM_PHOCACOLLAPSE_STORAGE_SESSION</option>
					<option value="local">PLG_SYSTEM_PHOCACOLLAPSE_STORAGE_LOCAL</option>
				</field>



				<field
					name="divider_4"
					type="note"
					class="w-100 my-1"
					label=" "
					description="" />
					
					
				<field
					name="show_reset_button"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					showon="preserve_collapse_state:1"
					label="PLG_SYSTEM_PHOCACOLLAPSE_SHOW_RESET_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_SHOW_RESET_DESC">
	
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>



				<field
					name="show_status_indicators"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					showon="preserve_collapse_state:1"
					label="PLG_SYSTEM_PHOCACOLLAPSE_SHOW_INDICATORS_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_SHOW_INDICATORS_DESC">
	
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>


				<field
					name="divider_5"
					type="note"
					class="w-100 border-bottom my-4"
					label=" "
					description="" />
				

				<field
    				name="list_collapse_active"
    				type="radio"
    				layout="joomla.form.field.radio.switcher"
    				default="1"
    				label="PLG_SYSTEM_PHOCACOLLAPSE_LIST_ACTIVE_LABEL"
    				description="PLG_SYSTEM_PHOCACOLLAPSE_LIST_ACTIVE_DESC">
    
    				<option value="0">JNO</option>
    				<option value="1">JYES</option>
				</field>

				
				<field
					name="frontend_active"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="0"
					label="PLG_SYSTEM_PHOCACOLLAPSE_ACTIVE_IN_FRONTEND_LABEL"
					description="PLG_SYSTEM_PHOCACOLLAPSE_ACTIVE_IN_FRONTEND_DESC">

					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				

			</fieldset>
		</fields>
	</config>

	<updateservers>
		<server
			type="extension"
			name="PLG_SYSTEM_PHOCACOLLAPSE"
			priority="1"><![CDATA[https://raw.githubusercontent.com/PhocaCz/PhocaCollapse/main/manifest.xml]]></server>
	</updateservers>

</extension>
